generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Inquires {
  id               Int      @id @default(autoincrement())
  inquiry_type     String
  name             String
  email            String
  phone            String
  subject          String
  message          String
  funding          String?
  attendees        String?
  course           String?
  service_interest String?
  project_scale    String?
  timeline         String?
  budget           String?
  project_desc     String?
  tech_specs       String?
  status           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model Users {
  id                Int          @id @default(autoincrement())
  username          String
  password          String
  email             String?
  role              String       @default("Student ")
  active_status     Boolean      @default(false)
  sessionVersion    Int             @default(0)
  createdAt         DateTime     @default(now())
  programs_enrolled String
  pending_status    String       @default("Pending")
  enrollments       Enrollment[]
  gradebooks        UserGradebook[]
  examAttempts      ExamAttempt[]
  first_name        String       @default("")
  last_name         String       @default("")
  birth_date        DateTime     @default(now())
  gender            String?
  city_province     String       @default("")
  phone_number      String?
  profile_photo     String?
  expiration_date   DateTime?
}

model UserGradebook {
  id         Int      @id @default(autoincrement())
  userId     Int
  programKey String
  data       Json     @db.JsonB
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programKey])
  @@index([programKey])
}

model ExamAttempt {
  id              String    @id
  userId          Int
  examKey         String
  questionSet     Json      @db.JsonB
  durationSeconds Int
  deadline        DateTime
  score           Int?
  review          Json?     @db.JsonB
  submittedAt     DateTime?
  user            Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, examKey])
}

model AuthLoginAttempt {
  key             String   @id
  windowStartedAt DateTime
  attempts        Int

  @@index([windowStartedAt])
}

model OtpCode {
  id               Int       @id @default(autoincrement())
  email            String
  purpose          String
  codeHash         String
  expiresAt        DateTime
  attempts         Int       @default(0)
  consumedAt       DateTime?
  verificationHash String?
  verifiedUntil    DateTime?
  createdAt        DateTime  @default(now())

  @@index([email, purpose, consumedAt, createdAt])
}

model Questions {
  id             Int    @id @default(autoincrement())
  module         String
  topic          String
  difficulty     String
  question_text  String
  choices        String
  correct_answer String
  explanation    String
  imageUrl       String?
  question_type  String @default("single")
  match_items    Json?  @db.JsonB
}

model Program {
  id          Int          @id @default(autoincrement())
  name        String
  trainingId  Int?
  training    Training?    @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  parentId    Int?
  parent      Program?     @relation("ProgramModules", fields: [parentId], references: [id], onDelete: Cascade)
  modules     Program[]    @relation("ProgramModules")
  enrollmens  Enrollment[]

  @@index([parentId])
  @@index([trainingId])
}

model Training {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  programs Program[]
}

model Enrollment {
  userId     Int
  programId  Int
  enrolledAt DateTime @default(now())
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, programId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model QuestionsRls {
  id             Int     @id @default(autoincrement())
  module         String?
  topic          String?
  difficulty     String?
  question_text  String?
  choices        String?
  correct_answer String?
  explanation    String?

  @@map("questions")
}
